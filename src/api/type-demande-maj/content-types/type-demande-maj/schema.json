{
  "kind": "collectionType",
  "collectionName": "types_demande_maj",
  "info": {
    "singularName": "type-demande-maj",
    "pluralName": "types-demande-maj",
    "displayName": "Type de demande de mise a jour",
    "description": "Referentiel des demandes de mise a jour adressees a un operateur apres le depot. Un type porte UN SEUL genre : champs du formulaire, piece d'un type nouveau, ou nouvelle version d'une piece existante. Le melange est refuse a la creation de la campagne."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "code": { "type": "uid", "targetField": "libelle", "required": true },
    "genre": {
      "type": "enumeration",
      "enum": ["champs", "piece_nouvelle", "piece_revision"],
      "default": "champs",
      "required": true
    },
    "libelle": { "type": "string", "required": true },
    "phase": {
      "type": "enumeration",
      "enum": ["instruction", "maturation", "contractualisation", "suivi"],
      "default": "maturation",
      "required": true
    },
    "texteDemande": { "type": "text" },
    "piecesAttendues": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::type-piece.type-piece"
    },
    "piecesLibres": { "type": "json" },
    "montantsOuverts": { "type": "boolean", "default": false },
    "champsOuverts": { "type": "json" },
    "delaiJoursDefaut": { "type": "integer", "default": 5 },
    "relances": { "type": "json" },
    "validationRequise": { "type": "boolean", "default": true },
    "ordre": { "type": "integer", "default": 0 },
    "actif": { "type": "boolean", "default": true }
  }
}
