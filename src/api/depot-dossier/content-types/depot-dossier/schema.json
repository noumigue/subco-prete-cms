{
  "kind": "collectionType",
  "collectionName": "depots_dossier",
  "info": {
    "singularName": "depot-dossier",
    "pluralName": "depots-dossier",
    "displayName": "Depot de dossier"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
