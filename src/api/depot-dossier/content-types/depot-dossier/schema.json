      "inversedBy": "depots"
    },
    "version": { "type": "integer", "required": true },
    "deposeLe": { "type": "datetime", "required": true },
    "pdf": { "type": "media", "multiple": false, "allowedTypes": ["files"] },
    "donneesProjet": { "type": "json" },
    "titreProjet": { "type": "string" },
    "auteurLibelle": { "type": "string" }
  }
}
